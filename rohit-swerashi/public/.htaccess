Options -MultiViews -Indexes
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One address for the whole site: https and www
  RewriteCond %{HTTP_HOST} ^rohitswerashi\.com$ [NC]
  RewriteRule ^ https://www.rohitswerashi.com%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.rohitswerashi\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.rohitswerashi.com%{REQUEST_URI} [R=301,L]

  # Old addresses
  RewriteRule ^work/?$ /experience [R=301,L]
  RewriteRule ^work/(.+?)/?$ /experience/$1 [R=301,L]
  RewriteRule ^themes/?$ /recognition [R=301,L]
  RewriteRule ^experience/films/?$ /experience/genios [R=301,L]

  # No trailing slash
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /experience serves /experience/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(js|css|webp|png|jpg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>
